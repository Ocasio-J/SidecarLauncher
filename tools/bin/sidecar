#!/usr/bin/env bash
set -euo pipefail

NAME="${NAME:-iPad}"

VENDOR_VDISP="0x5644"
VENDOR_SIDECAR="0x6161706c"
MODEL_SIDECAR="0x69506164"

POLL_INTERVAL=0.5
VDISP_TIMEOUT=10
CONNECT_ATTEMPTS=5
CONNECT_SETTLE=3
CONNECT_DISPLAY_WAIT="${CONNECT_DISPLAY_WAIT:-25}"
RETRY_DELAY=5
DOWN_TIMEOUT=5
RESTART_TIMEOUT=15

if [ -n "${SIDECAR_BIN:-}" ]; then
  if [ -d "$SIDECAR_BIN" ]; then
    BIN="$(cd -P "$SIDECAR_BIN" && pwd)"
  else
    printf 'ERROR: SIDECAR_BIN is set but not a usable directory: %s\n' "$SIDECAR_BIN" >&2
    exit 1
  fi
else
  SELF="${BASH_SOURCE[0]:-$0}"
  while [ -L "$SELF" ]; do
    LINK_DIR="$(cd -P "$(dirname "$SELF")" && pwd)"
    SELF="$(readlink "$SELF")"
    case "$SELF" in
      /*) ;;
      *) SELF="$LINK_DIR/$SELF" ;;
    esac
  done
  BIN="$(cd -P "$(dirname "$SELF")" && pwd)"
fi
TOOLS="$(cd -P "$BIN/.." && pwd)"
LOGS="$TOOLS/logs"
LOG="$LOGS/sidecar.log"
RES_FILE="$TOOLS/state/resolution"

mkdir -p "$LOGS" "$TOOLS/state" 2>/dev/null || true

ts() { date "+%Y-%m-%dT%H:%M:%S%z"; }
log() { printf '%s %s\n' "$(ts)" "$*" >>"$LOG" 2>/dev/null || true; }
info() { log "$*"; printf '%s\n' "$*"; }
warn() { log "WARN $*"; printf 'WARN: %s\n' "$*" >&2; }
fail() { log "ERROR $*"; printf 'ERROR: %s\n' "$*" >&2; }

need_bin() {
  local b
  for b in "$@"; do
    if [ ! -x "$BIN/$b" ]; then
      fail "missing or non-executable binary: $BIN/$b (run ./build.sh)"
      return 1
    fi
  done
}

dispid_out() { "$BIN/dispid" 2>/dev/null || true; }

vdisp_pids() {
  { pgrep -f "$BIN/vdisp" 2>/dev/null || true; pgrep -x vdisp 2>/dev/null || true; } | sort -u | tr '\n' ' '
}

vdisp_pid() { vdisp_pids | awk '{print $1}'; }

vdisp_count() { vdisp_pids | wc -w | tr -d ' '; }

count_displays() {
  dispid_out | grep -cE "$1" || true
}

sidecar_probe_state() {
  local rc=0
  if [ -x "$BIN/connected" ]; then
    "$BIN/connected" >/dev/null 2>&1 || rc=$?
  else
    rc=3
  fi
  case "$rc" in
    0) printf 'connected' ;;
    1) printf 'disconnected' ;;
    *) printf 'unknown' ;;
  esac
}

classify_connect() {
  local out="$1" rc="$2"
  case "$out" in
    *-501*|*SidecarErrorVirtualDisplayFailed*) printf 'fatal501'; return 0 ;;
    *-455*|*SidecarErrorDisplayAWDLDegraded*) printf 'retry'; return 0 ;;
    *-101*|*SidecarErrorServiceDisconnected*) printf 'retry'; return 0 ;;
    *-203*|*SidecarErrorDeviceWiFiNotEnabled*) printf 'retry'; return 0 ;;
    *"No sidecar capable devices"*) printf 'retry'; return 0 ;;
  esac
  if [ "$rc" -eq 2 ]; then
    printf 'retry'
    return 0
  fi
  printf 'fatal'
}

virtual_display_present() {
  dispid_out | grep -qE "vendor=$VENDOR_VDISP([[:space:]]|$)"
}

sidecar_connected() {
  dispid_out | grep -qE "vendor=$VENDOR_SIDECAR([[:space:]]|$)|model=$MODEL_SIDECAR([[:space:]]|$)"
}

builtin_present() {
  dispid_out | grep -qE '(^|[[:space:]])builtin=true([[:space:]]|$)'
}

display_line() {
  dispid_out | grep -E "$1" | head -n 1 || true
}

sidecar_lines() {
  dispid_out | grep -E "vendor=$VENDOR_SIDECAR([[:space:]]|$)|model=$MODEL_SIDECAR([[:space:]]|$)" || true
}

live_sidecar_line() {
  sidecar_lines | awk '{
    id = 0; active = 0; mo = 0
    for (i = 1; i <= NF; i++) {
      if ($i ~ /^id=/) { split($i, a, "="); id = a[2] + 0 }
      else if ($i == "active=true") { active = 1 }
      else if ($i ~ /^mirror_of=/) { split($i, a, "="); mo = a[2] + 0 }
    }
    if ((active == 1 || mo != 0) && id >= best) { best = id; line = $0 }
  }
  END { if (line != "") print line }'
}

any_sidecar_line() {
  sidecar_lines | head -n 1
}

virtual_line() {
  local main_line
  main_line="$(dispid_out | grep -E "vendor=$VENDOR_VDISP([[:space:]]|$)" | grep -E '(^|[[:space:]])main=true([[:space:]]|$)' | head -n 1 || true)"
  if [ -n "$main_line" ]; then
    printf '%s\n' "$main_line"
    return 0
  fi
  display_line "vendor=$VENDOR_VDISP([[:space:]]|$)"
}

field() {
  printf '%s\n' "$1" | tr ' ' '\n' | sed -n "s/^$2=//p" | head -n 1
}

resolution() {
  printf '%s\n' "$1" | awk '{print $NF}'
}

is_main() {
  printf '%s\n' "$1" | tr ' ' '\n' | grep -qx 'main=true'
}

lid_state() {
  local out=""
  out="$(ioreg -r -k AppleClamshellState 2>/dev/null)" || out=""
  case "$out" in
    *'"AppleClamshellState" = Yes'*) printf 'closed' ;;
    *'"AppleClamshellState" = No'*) printf 'open' ;;
    *) printf 'unknown' ;;
  esac
}

mirror_state() {
  local out="" value=""
  out="$(system_profiler SPDisplaysDataType 2>/dev/null)" || out=""
  if [ -z "$out" ]; then
    printf 'n/a'
    return 0
  fi
  value="$(printf '%s\n' "$out" | awk '
    /^[[:space:]]+[^[:space:]].*:[[:space:]]*$/ {
      name=$0
      sub(/^[[:space:]]+/, "", name)
      sub(/:[[:space:]]*$/, "", name)
    }
    /Mirror:[[:space:]]*/ { if (name ~ /Sidecar/) { sub(/.*Mirror:[[:space:]]*/, ""); print; exit } }
  ')"
  if [ -z "$value" ]; then
    printf 'n/a'
    return 0
  fi
  case "$value" in
    [Oo]n*|[Yy]es*|[Ss]ì*|[Ss]i*|[Aa]ttiv*|1) printf 'yes' ;;
    [Oo]ff*|[Nn]o*|[Dd]isattiv*|0) printf 'no' ;;
    *) printf '%s' "$value" ;;
  esac
}

read_state_resolution() {
  local v=""
  if [ -f "$RES_FILE" ]; then
    v="$(tr '\n' ' ' <"$RES_FILE" 2>/dev/null | sed 's/[[:space:]]*$//')" || v=""
  fi
  printf '%s' "$v"
}

res_show() {
  local raw block current saved
  raw="$("$BIN/dispmode" 2>/dev/null || true)"
  if [ -z "$raw" ]; then
    fail "cannot read display modes (bin/dispmode)"
    return 1
  fi

  block="$(printf '%s\n' "$raw" | awk -v v="vendor=$VENDOR_SIDECAR" '
    /^display / { insb = ($3 == v); next }
    insb && !/^[[:space:]]*$/ { print }
  ')"
  current="$(printf '%s\n' "$block" | sed -n 's/^[[:space:]]*NOW: //p' | head -n 1)"
  saved="$(read_state_resolution)"

  printf 'sidecar display: id=%s\n' "$(field "$(any_sidecar_line)" id)"
  printf 'current:         %s\n' "${current:-unknown}"
  printf 'HiDPI:\n'
  if printf '%s\n' "$block" | grep -q '<-- HiDPI'; then
    printf '%s\n' "$block" | grep '<-- HiDPI' | sed 's/^[[:space:]]*/  /; s/[[:space:]]*<-- HiDPI$//'
  else
    printf '  no HiDPI mode available\n'
  fi
  printf 'saved:           %s\n' "${saved:-none}"
  printf 'apply with:      sidecar res WxH\n'
  return 0
}

apply_saved_resolution() {
  local target
  target="$(read_state_resolution)"
  if [ -z "$target" ]; then
    return 0
  fi
  need_bin setmode || return 0
  if "$BIN/setmode" "$target" >>"$LOGS/setmode.log" 2>&1; then
    info "resolution $target applied (state/resolution)"
  else
    warn "resolution $target not available, keeping the current one (see $LOGS/setmode.log)"
  fi
  return 0
}

disconnect_quiet() {
  local out="" rc=0
  out="$("$BIN/SidecarLauncher" disconnect "$NAME" 2>&1)" || rc=$?
  if [ "$rc" -ne 0 ]; then
    log "disconnect \"$NAME\" exit $rc (ignored): $(printf '%s' "$out" | tr '\n' ' ')"
  fi
  return 0
}

usage() {
  cat <<EOF
usage: sidecar <command>

  ensure    make sure the virtual display ($VENDOR_VDISP) is up
  up        ensure + connect to "$NAME" + saved resolution + arrange + mirror
  down      disconnect from "$NAME" (idempotent)
  status    lid, vdisp, Sidecar and mirror state (read-only)
  doctor    consistency check of displays, vdisp and Sidecar (read-only)
  restart-vdisp  SIGTERM the virtual display process and wait for a fresh display
  res       current mode and HiDPI modes of the Sidecar display; res WxH sets and saves one

variables:
  NAME      name of the Sidecar device (default: iPad)

files:
  log       $LOG
  state     $RES_FILE (resolution reapplied when "up" reconnects)
EOF
}

usage_ensure() {
  cat <<EOF
usage: sidecar ensure [--help]

Starts bin/vdisp if it is not already running, then waits up to ${VDISP_TIMEOUT}s for a
display with vendor $VENDOR_VDISP to appear.

exit 0 if the virtual display is up, 1 otherwise.
EOF
}

usage_up() {
  cat <<EOF
usage: sidecar up [--force] [--help]

1. ensure the virtual display
2. if the session is already healthy, a live Sidecar display with the probe reporting
   connected (or unavailable), run the layout step and return 0 without reconnecting:
   state/resolution is not reapplied on a healthy session. A healthy session is a
   no-op apart from arranging the desktop, which is idempotent
3. otherwise reconnect to "$NAME": disconnect first to clear zombie sessions (errors
   ignored), then pass 1
4. if state/resolution exists, compare it with the mode macOS negotiated in pass 1
5. only when they differ: setmode to the saved mode, then pass 2 (disconnect and connect
   again) so the new session inherits it. macOS remembers the mode per display, but a
   change made on a live session is only reliably applied at the next connection. Every
   connect creates a new Sidecar display id and Universal Control on other devices
   accumulates duplicate tiles, so there is no reconnect when nothing changes
6. verify the current mode against state/resolution; a mismatch is a warning, not a
   failure (run up again, or reconnect the iPad by hand)
7. with the lid closed, arrange the displays so that the virtual display is main at
   (0,0) and Sidecar mirrors it (bin/arrange). Measured on a closed lid: Universal
   Control holds ~4 minutes this way, ~1 minute with Sidecar as main. The mirrored
   desktop is as big as the virtual display, which is why its size comes from the
   LaunchAgent environment (1321x918) rather than the 640x480 default
8. mirror the Sidecar display onto the built-in one, when a built-in exists
   (with the lid closed the mirror and the arrangement are skipped and the command
   still succeeds)

--force skips the healthy-session no-op and performs the full reconnect path, so the
saved mode is reapplied even on an otherwise-healthy session.

Without state/resolution there is a single connect and no second pass.

Retried (transient, verified): -455 SidecarErrorDisplayAWDLDegraded,
-101 SidecarErrorServiceDisconnected, -203 SidecarErrorDeviceWiFiNotEnabled,
exit 2 / "No sidecar capable devices detected".
Aborted immediately (no retry): -501 SidecarErrorVirtualDisplayFailed and every other
error, because retrying a corrupted display configuration only adds orphan displays.

exit 0 if Sidecar is connected, 1 otherwise.
EOF
}

usage_down() {
  cat <<EOF
usage: sidecar down [--help]

Disconnects "$NAME" and waits up to ${DOWN_TIMEOUT}s for the Sidecar display to go away.
Idempotent: with no session it exits 0.

exit 0 if no Sidecar display is left, 1 otherwise.
EOF
}

usage_status() {
  cat <<EOF
usage: sidecar status [--help]

Prints the lid state (open/closed), vdisp, the Sidecar display (id and resolution), the
mirror as reported by bin/dispid (sidecar N -> M) and, when a session is suspended, that
its display is asleep.

A Sidecar display is "live" when bin/dispid reports active=true or mirror_of != 0. Whether
Sidecar is connected comes from SidecarDisplayManager.connectedDevices (bin/connected);
when that probe is unavailable the display list is used and the output says so.

exit 0 if Sidecar is connected (or assumed connected), 1 if not.
EOF
}

usage_doctor() {
  cat <<EOF
usage: sidecar doctor [--help]

Read-only consistency check. Compares:
  - displays with vendor $VENDOR_VDISP against live vdisp processes (more displays than
    processes means zombie displays);
  - the Sidecar display ($VENDOR_SIDECAR) against SidecarDisplayManager.connectedDevices:
    live/connected is ok, a suspended display (asleep) is info, an orphaned display with
    no connected device is a problem;
  - vdisp being alive at all (the LaunchAgent's job);
  - with the lid closed, whether the virtual display is main and the live Sidecar mirrors
    it (the arrangement bin/arrange applies);
  - the lid state.

Every problem comes with the action that fixes it. Changes nothing.

exit 0 if everything is consistent, 1 if at least one problem is found.
EOF
}

usage_restart_vdisp() {
  cat <<EOF
usage: sidecar restart-vdisp [--help]

Sends SIGTERM to the vdisp process(es) found with pgrep and waits up to ${RESTART_TIMEOUT}s
for the old display ($VENDOR_VDISP) to leave the display list and a new one to appear;
launchd KeepAlive starts it again with a fresh identity.

SIGTERM lets the process release its display. SIGKILL, "launchctl kickstart -k" and
"launchctl bootout" do not: they leave an orphan display behind.

exit 0 if the display was rebuilt, 1 if it is still the old one (open and close the lid).
EOF
}

usage_res() {
  cat <<EOF
usage: sidecar res [WxH] [--help]

Without arguments: current mode of the Sidecar display and the HiDPI modes available
(read-only).

With WxH (e.g. 1165x809): apply the mode, save it in state/resolution and reapply it when
"sidecar up" reconnects. A healthy session is left alone, so the saved mode is not
reapplied by an idempotent "up": use "sidecar up --force" to reapply it.

Requires a connected Sidecar display.
exit 0 if the mode was read or applied, 1 otherwise.
EOF
}

cmd_ensure() {
  local pid="" i
  need_bin vdisp dispid || return 1

  if virtual_display_present; then
    pid="$(vdisp_pid)"
    if [ -n "$pid" ]; then
      info "virtual display $VENDOR_VDISP already up (vdisp pid $pid)"
    else
      info "virtual display $VENDOR_VDISP already up (no vdisp process found)"
    fi
    return 0
  fi

  pid="$(vdisp_pid)"
  if [ -n "$pid" ]; then
    info "vdisp running (pid $pid), waiting for the virtual display"
  else
    info "starting vdisp"
    nohup "$BIN/vdisp" >>"$LOGS/vdisp.log" 2>&1 &
    disown 2>/dev/null || true
  fi

  for i in $(seq 1 $((VDISP_TIMEOUT * 2))); do
    if virtual_display_present; then
      info "virtual display $VENDOR_VDISP up"
      return 0
    fi
    sleep "$POLL_INTERVAL"
  done

  fail "virtual display $VENDOR_VDISP did not appear within ${VDISP_TIMEOUT}s (see $LOGS/vdisp.log)"
  return 1
}

current_sidecar_mode() {
  local line
  line="$(live_sidecar_line)"
  if [ -z "$line" ]; then
    line="$(any_sidecar_line)"
  fi
  if [ -z "$line" ]; then
    return 0
  fi
  resolution "$line"
}

wait_for_live_display() {
  local wait="$1" i live
  for i in $(seq 1 $((wait * 2))); do
    live="$(live_sidecar_line)"
    if [ -n "$live" ]; then
      printf '%s\n' "$live"
      return 0
    fi
    sleep "$POLL_INTERVAL"
  done
  return 1
}

connect_with_retries() {
  local attempt rc out live last_out="" last_rc=0 flaps=0

  for attempt in $(seq 1 "$CONNECT_ATTEMPTS"); do
    info "connect \"$NAME\" (attempt $attempt/$CONNECT_ATTEMPTS)"
    rc=0
    last_out=""
    out="$("$BIN/SidecarLauncher" connect "$NAME" 2>&1)" || rc=$?
    out="$(printf '%s' "$out" | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
    log "connect \"$NAME\" exit $rc: ${out:-no output}"

    if [ "$rc" -eq 0 ]; then
      sleep "$CONNECT_SETTLE"
      if live="$(wait_for_live_display "$CONNECT_DISPLAY_WAIT")"; then
        info "Sidecar connected (id=$(field "$live" id), $(resolution "$live"))"
        return 0
      fi
      case "$(sidecar_probe_state)" in
        connected)
          fail "connect returned ok but no live Sidecar display appeared within ${CONNECT_DISPLAY_WAIT}s and the session still claims connected (run sidecar doctor)"
          return 1
          ;;
        disconnected)
          flaps=$((flaps + 1))
          if [ "$flaps" -ge 2 ]; then
            fail "the session closed right after connecting twice: likely a stale display or the iPad held by another Mac; run sidecar doctor"
            return 1
          fi
          warn "connect returned ok but the session closed before the display appeared (attempt $attempt): not a success, retrying"
          ;;
        *)
          fail "connect returned ok but the session state is unknown (probe unavailable)"
          return 1
          ;;
      esac
    else
      last_out="$out"
      last_rc="$rc"
      case "$(classify_connect "$out" "$rc")" in
        fatal501)
          fail "Sidecar could not create its virtual display (-501).
The display configuration is likely corrupted (zombie virtual displays).
Open and close the lid once to force the WindowServer to re-enumerate
displays, then retry. Do not SIGKILL vdisp: it leaves orphan displays."
          return 1
          ;;
        retry)
          warn "connect failed with exit $rc: ${out:-no output} (attempt $attempt), retrying"
          ;;
        *)
          fail "connect failed with exit $rc: ${out:-no output} (not retryable, stopped at attempt $attempt)"
          return 1
          ;;
      esac
    fi

    if [ "$attempt" -lt "$CONNECT_ATTEMPTS" ]; then
      sleep "$RETRY_DELAY"
    fi
  done

  if [ -n "$last_out" ] && printf '%s' "$last_out" | grep -qE -- '-455|SidecarErrorDisplayAWDLDegraded'; then
    fail "Sidecar not connected after $CONNECT_ATTEMPTS attempts
The last error was -455 (AWDL degraded). If the iPad is visible in \`sidecar\`
but refuses every attempt, its radio state is likely stale:
toggle Wi-Fi and Bluetooth on the iPad, turn off Low Power Mode, then retry."
  else
    fail "Sidecar not connected after $CONNECT_ATTEMPTS attempts"
  fi
  return 1
}

layout_step() {
  if builtin_present; then
    if "$BIN/mirror" >>"$LOGS/mirror.log" 2>&1; then
      info "mirror applied onto the built-in display"
    else
      warn "mirror failed (see $LOGS/mirror.log), the Sidecar session stays up"
    fi
  else
    info "no built-in display (lid closed): mirror skipped, arranging the desktop"
    if "$BIN/arrange" >>"$LOGS/arrange.log" 2>&1; then
      info "desktop arranged: virtual display is main, Sidecar mirrors it"
    else
      warn "arrange failed (see $LOGS/arrange.log), the session stays up: run bin/arrange by hand"
    fi
  fi
}

cmd_up() {
  local force="${UP_FORCE:-0}" target current probe live

  need_bin vdisp dispid SidecarLauncher mirror setmode arrange || return 1

  cmd_ensure || return 1

  probe="$(sidecar_probe_state)"
  live="$(live_sidecar_line)"

  if [ "$force" -eq 0 ] && [ -n "$live" ] && { [ "$probe" = "connected" ] || [ "$probe" = "unknown" ]; }; then
    if [ "$probe" = "connected" ]; then
      info "session healthy (id=$(field "$live" id)): no reconnect"
    else
      warn "probe unavailable: assuming the live display is the session; use --force to reconnect"
    fi
    layout_step
    return 0
  fi

  info "clearing previous sessions for \"$NAME\""
  disconnect_quiet
  sleep 1

  info "pass 1: negotiate with \"$NAME\""
  connect_with_retries || return 1

  target="$(read_state_resolution)"
  if [ -z "$target" ]; then
    info "no saved mode in state/resolution: keeping the negotiated one"
  else
    current="$(current_sidecar_mode)"
    if [ "$current" = "$target" ]; then
      info "mode $target already negotiated by macOS: no reconnect needed"
    else
      info "negotiated ${current:-unknown}, saved $target: applying it"
      apply_saved_resolution

      info "pass 2: reconnect to inherit mode $target"
      disconnect_quiet
      sleep 1
      connect_with_retries || return 1

      current="$(current_sidecar_mode)"
      if [ "$current" = "$target" ]; then
        info "mode $target inherited by the new session"
      else
        warn "the Sidecar display is at ${current:-unknown}, not $target: run \"sidecar up\" again or reconnect the iPad by hand (see README)"
      fi
    fi
  fi

  layout_step
  return 0
}

cmd_down() {
  local i
  need_bin dispid SidecarLauncher || return 1

  disconnect_quiet
  info "disconnect \"$NAME\" sent"

  for i in $(seq 1 $((DOWN_TIMEOUT * 2))); do
    sleep "$POLL_INTERVAL"
    if ! sidecar_connected; then
      info "no Sidecar display left"
      return 0
    fi
  done

  fail "the Sidecar display is still present after ${DOWN_TIMEOUT}s"
  return 1
}

display_id_present() {
  dispid_out | grep -qE "^id=$1([[:space:]]|$)"
}

cmd_restart_vdisp() {
  local pids oldpid pid before after still newpid i id

  need_bin dispid || return 1

  pids="$(vdisp_pids)"
  pids="$(printf '%s' "$pids" | sed 's/[[:space:]]*$//')"
  if [ -z "$pids" ]; then
    fail "no vdisp process found: nothing to restart (start it with ./install.sh or \"sidecar ensure\")"
    return 1
  fi
  oldpid="$(printf '%s' "$pids" | awk '{print $1}')"

  before="$(dispid_out | grep -E "vendor=$VENDOR_VDISP([[:space:]]|$)" | sed -n 's/^id=\([0-9][0-9]*\).*/\1/p' | tr '\n' ' ')"

  info "sending SIGTERM to vdisp ($pids)"
  for pid in $pids; do
    kill -TERM "$pid" 2>/dev/null || warn "could not send SIGTERM to pid $pid"
  done

  still=1
  for i in $(seq 1 $((RESTART_TIMEOUT * 2))); do
    sleep "$POLL_INTERVAL"
    still=0
    for id in $before; do
      if display_id_present "$id"; then
        still=1
      fi
    done
    newpid="$(vdisp_pid)"
    if [ "$still" -eq 0 ] && [ -n "$newpid" ] && [ "$newpid" != "$oldpid" ] && virtual_display_present; then
      after="$(dispid_out | grep -E "vendor=$VENDOR_VDISP([[:space:]]|$)" | sed -n 's/^id=\([0-9][0-9]*\).*/\1/p' | tr '\n' ' ')"
      info "vdisp restarted (pid $oldpid -> $newpid), display rebuilt"
      info "virtual displays: $(printf '%s' "$after" | sed 's/[[:space:]]*$//')"
      return 0
    fi
  done

  if [ "$still" -ne 0 ]; then
    fail "the old virtual display ($(printf '%s' "$before" | sed 's/[[:space:]]*$//')) is still listed after ${RESTART_TIMEOUT}s: open and close the lid once to re-enumerate the displays"
    return 1
  fi

  fail "the display was released but vdisp did not come back within ${RESTART_TIMEOUT}s: start it with ./install.sh or \"sidecar ensure\""
  return 1
}

cmd_status() {
  local lid pid vline live anyl mirror mirror_flag mirror_line stated probe

  need_bin dispid || return 1

  probe="$(sidecar_probe_state)"

  lid="$(lid_state)"
  printf '%-17s %s\n' 'lid:' "$lid"

  pid="$(vdisp_pid)"
  if [ -n "$pid" ]; then
    printf '%-17s %s\n' 'vdisp:' "alive (pid $pid)"
  else
    printf '%-17s %s\n' 'vdisp:' "not running"
  fi

  if virtual_display_present; then
    vline="$(virtual_line)"
    printf '%-17s %s\n' 'virtual display:' "$VENDOR_VDISP up ($(resolution "$vline"), id=$(field "$vline" id))"
  else
    printf '%-17s %s\n' 'virtual display:' "$VENDOR_VDISP absent"
  fi

  live="$(live_sidecar_line)"
  anyl="$(any_sidecar_line)"

  case "$probe" in
    connected)
      stated=connected
      if [ -n "$live" ]; then
        if is_main "$live"; then
          printf '%-17s %s\n' 'sidecar:' "connected (id=$(field "$live" id), $(resolution "$live"), main)"
        else
          printf '%-17s %s\n' 'sidecar:' "connected (id=$(field "$live" id), $(resolution "$live"))"
        fi
      elif [ -n "$anyl" ]; then
        if [ "$(field "$anyl" asleep)" = "true" ]; then
          printf '%-17s %s\n' 'sidecar:' "suspended (display $(field "$anyl" id) asleep): waiting for display wake"
        else
          printf '%-17s %s\n' 'sidecar:' "connected, display $(field "$anyl" id) listed but not live"
        fi
      else
        printf '%-17s %s\n' 'sidecar:' "connected, no display listed yet"
      fi
      ;;
    disconnected)
      stated=disconnected
      if [ -n "$anyl" ]; then
        printf '%-17s %s\n' 'sidecar:' "not connected (display $(field "$anyl" id) still listed: orphaned)"
      else
        printf '%-17s %s\n' 'sidecar:' "not connected"
      fi
      ;;
    *)
      if [ -n "$live" ]; then
        stated=connected
        printf '%-17s %s\n' 'sidecar:' "display live (id=$(field "$live" id), $(resolution "$live"), probe unavailable): assumed connected"
      elif [ -n "$anyl" ]; then
        stated=disconnected
        printf '%-17s %s\n' 'sidecar:' "probe unavailable: display $(field "$anyl" id) listed, cannot tell a suspended session from an orphan"
      else
        stated=disconnected
        printf '%-17s %s\n' 'sidecar:' "probe unavailable: no Sidecar display listed"
      fi
      ;;
  esac

  if [ -n "$live" ] || [ -n "$anyl" ]; then
    if [ -n "$live" ]; then mirror_line="$live"; else mirror_line="$anyl"; fi
    mirror_flag="$(field "$mirror_line" mirror_of)"
    if [ -z "$mirror_flag" ]; then
      mirror="$(mirror_state)"
      mirror_flag="$mirror"
    elif [ "$mirror_flag" = "0" ]; then
      mirror="sidecar $(field "$mirror_line" id) -> none"
      mirror_flag="no"
    else
      mirror="sidecar $(field "$mirror_line" id) -> $mirror_flag"
      mirror_flag="yes"
    fi
  else
    mirror="n/a"
    mirror_flag="n/a"
  fi
  printf '%-17s %s\n' 'mirror:' "$mirror"

  log "status: lid=$lid vdisp=${pid:-no} sidecar=$stated display_list=$(if [ -n "$anyl" ]; then printf 1; else printf 0; fi) mirror=$mirror_flag"

  if [ "$stated" = connected ]; then
    return 0
  fi
  return 1
}

check_ok() { printf 'ok    %s\n' "$1"; }
check_info() { printf 'info  %s\n' "$1"; }
check_bad() {
  problems=$((problems + 1))
  printf 'FAIL  %s\n' "$1"
  printf '      fix: %s\n' "$2"
}

cmd_doctor() {
  local problems=0 lid pids pcount vcount scount probe_out probe_rc probe_state cdev devices
  local vline live anyl asleep vid sid vmain lmirror

  need_bin dispid || return 1

  probe_rc=0
  probe_out=""
  if [ -x "$BIN/connected" ]; then
    probe_out="$("$BIN/connected" 2>/dev/null)" || probe_rc=$?
  else
    probe_rc=3
  fi
  case "$probe_rc" in
    0) probe_state="connected" ;;
    1) probe_state="disconnected" ;;
    *) probe_state="unknown" ;;
  esac

  dev_rc=0
  dev_out=""
  if [ -x "$BIN/SidecarLauncher" ]; then
    dev_out="$("$BIN/SidecarLauncher" devices 2>&1)" || dev_rc=$?
  else
    dev_rc=127
  fi

  pids="$(vdisp_pids)"
  pids="$(printf '%s' "$pids" | sed 's/[[:space:]]*$//')"
  pcount="$(vdisp_count)"
  vcount="$(count_displays "vendor=$VENDOR_VDISP([[:space:]]|$)")"
  scount="$(count_displays "vendor=$VENDOR_SIDECAR([[:space:]]|$)|model=$MODEL_SIDECAR([[:space:]]|$)")"
  lid="$(lid_state)"
  devices="$(printf '%s\n' "$probe_out" | sed -n 's/^device=//p' | paste -sd ',' - | sed 's/,/, /g')"

  live="$(live_sidecar_line)"
  anyl="$(any_sidecar_line)"
  vline="$(virtual_line)"

  printf 'doctor: read-only consistency check\n\n'
  printf '  %-19s %s\n' 'lid:' "$lid"
  if [ "$pcount" -eq 0 ]; then
    printf '  %-19s %s\n' 'vdisp:' "no process"
  elif [ "$pcount" -eq 1 ]; then
    printf '  %-19s %s\n' 'vdisp:' "1 process (pid $pids)"
  else
    printf '  %-19s %s\n' 'vdisp:' "$pcount processes (pids $pids)"
  fi
  printf '  %-19s %s\n' '0x5644 displays:' "$vcount"
  printf '  %-19s %s\n' 'sidecar displays:' "$scount"

  if [ "$probe_state" = "unknown" ]; then
    cdev="unknown (probe unavailable)"
  else
    cdev="$(printf '%s\n' "$probe_out" | sed -n 's/^connected=//p' | head -n 1)"
    if [ -n "$devices" ]; then
      cdev="$cdev ($devices)"
    fi
  fi
  printf '  %-19s %s\n' 'connected devices:' "$cdev"
  printf '\n'

  if [ "$pcount" -eq 0 ]; then
    check_bad "no vdisp process is running ($vcount display(s) with vendor $VENDOR_VDISP still registered)" \
      "start the agent: ./install.sh (or launchctl bootstrap gui/$(id -u)); if displays remain with no process, open and close the lid"
  elif [ "$vcount" -gt "$pcount" ]; then
    check_bad "$vcount virtual display(s) for $pcount vdisp process(es): zombie displays" \
      "open and close the lid once to re-enumerate the displays; sidecar restart-vdisp (SIGTERM) only helps when the surplus display still belongs to a live process. kill -9, launchctl kickstart -k and bootout all leave the display behind"
  elif [ "$vcount" -lt "$pcount" ]; then
    check_bad "$pcount vdisp process(es) but only $vcount virtual display(s)" \
      "run sidecar restart-vdisp (SIGTERM, never kill -9), or open and close the lid"
  else
    check_ok "one virtual display per vdisp process ($vcount = $pcount)"
  fi

  case "$probe_state" in
    connected)
      if [ -n "$live" ]; then
        check_ok "Sidecar is connected and its display is live"
      elif [ -n "$anyl" ]; then
        asleep="$(field "$anyl" asleep)"
        if [ "$asleep" = "true" ]; then
          check_info "Sidecar session suspended: waiting for display wake (display $(field "$anyl" id) asleep); caffeinate -u -t 2, or sidecar up"
        else
          check_info "device connected, display $(field "$anyl" id) listed but not live and not asleep: wait, or run sidecar up"
        fi
      else
        check_info "device connected, no display listed yet: wait"
      fi
      ;;
    disconnected)
      if [ -n "$anyl" ]; then
        check_bad "Sidecar display orphaned (no connected device): id $(field "$anyl" id)" \
          "wake first (caffeinate -u -t 2, may re-enumerate); if still listed, open and close the lid"
      else
        check_ok "no Sidecar display and no connected device"
      fi
      ;;
    *)
      if [ -n "$live" ]; then
        check_ok "probe unavailable: display live: assume healthy"
      elif [ -n "$anyl" ]; then
        check_info "probe unavailable: cannot distinguish a suspended session from an orphan: wake first, re-run doctor; if still listed, open and close the lid"
      else
        check_info "probe unavailable: no Sidecar display listed"
      fi
      ;;
  esac

  if [ "$probe_state" != "connected" ] && [ "$dev_rc" -eq 0 ]; then
    check_info "device reachable but not connected: a persistent -455 is usually the iPad radio state (see Troubleshooting)"
  fi

  if [ "$lid" = "closed" ] && [ -n "$live" ]; then
    vid="$(field "$vline" id)"
    sid="$(field "$live" id)"
    lmirror="$(field "$live" mirror_of)"
    if [ "$(field "$vline" main)" = "true" ] && [ "$lmirror" = "$vid" ]; then
      check_ok "lid closed: the virtual display ($vid) is main and Sidecar ($sid) mirrors it"
    else
      check_bad "lid closed but the desktop is not arranged as intended (virtual $(vid) main=$(field "$vline" main), sidecar $sid mirror_of=${lmirror:-unknown})" \
        "run sidecar up, or bin/arrange, to put the virtual display at (0,0) and mirror Sidecar onto it"
    fi
  fi

  case "$lid" in
    closed) check_info "lid closed: no built-in display, so up arranges the desktop instead of mirroring onto it" ;;
    open) check_info "lid open: a built-in display is available, up can mirror onto it" ;;
    *) check_info "lid state unknown" ;;
  esac

  if [ "$problems" -eq 0 ]; then
    printf '\nresult: consistent\n'
    log "doctor: consistent (vdisp=$pcount displays=$vcount sidecar=$probe_state lid=$lid)"
    return 0
  fi

  printf '\nresult: %d problem(s)\n' "$problems"
  log "doctor: $problems problem(s) (vdisp=$pcount displays=$vcount sidecar=$probe_state lid=$lid)"
  return 1
}

cmd_res() {
  local target="${1:-}" out="" rc=0
  need_bin dispid || return 1

  if ! sidecar_connected; then
    fail "no Sidecar display: connect first with \"sidecar up\""
    return 1
  fi

  if [ -z "$target" ]; then
    need_bin dispmode || return 1
    res_show
    return $?
  fi

  if ! printf '%s' "$target" | grep -Eq '^[0-9]+x[0-9]+$'; then
    fail "invalid mode: \"$target\" (expected WxH, e.g. 1165x809)"
    return 1
  fi

  need_bin setmode || return 1

  out="$("$BIN/setmode" "$target" 2>&1)" || rc=$?
  out="$(printf '%s' "$out" | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
  log "setmode $target exit $rc: ${out:-no output}"

  if [ "$rc" -ne 0 ]; then
    fail "mode $target not applied: ${out:-no output}"
    return 1
  fi

  if ! printf '%s\n' "$target" >"$RES_FILE"; then
    fail "mode $target applied but not saved in $RES_FILE"
    return 1
  fi

  info "mode $target applied ($out)"
  info "saved in $RES_FILE: it is reapplied when \"sidecar up\" reconnects (\"sidecar up --force\" reapplies it on a healthy session)"
  return 0
}

main() {
  local cmd help_fn

  UP_FORCE=0

  if [ "$#" -eq 0 ]; then
    usage >&2
    exit 1
  fi

  case "$1" in
    -h|--help|help) usage; exit 0 ;;
    ensure|up|down|status|doctor|restart-vdisp|res) ;;
    *) fail "unknown command: $1"; usage >&2; exit 1 ;;
  esac

  cmd="$1"
  shift
  help_fn="usage_${cmd//-/_}"

  if [ "$#" -gt 0 ] && { [ "$1" = "-h" ] || [ "$1" = "--help" ]; }; then
    "$help_fn"
    exit 0
  fi

  if [ "$cmd" = up ]; then
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --force) UP_FORCE=1 ;;
        *) fail "unrecognised argument: $1"; usage_up >&2; exit 1 ;;
      esac
      shift
    done
  elif [ "$cmd" = res ]; then
    if [ "$#" -gt 1 ]; then
      fail "too many arguments: $*"
      usage_res >&2
      exit 1
    fi
  elif [ "$#" -gt 0 ]; then
    fail "unrecognised argument: $1"
    "$help_fn" >&2
    exit 1
  fi

  case "$cmd" in
    ensure) if cmd_ensure; then exit 0; else exit 1; fi ;;
    up) if cmd_up; then exit 0; else exit 1; fi ;;
    down) if cmd_down; then exit 0; else exit 1; fi ;;
    status) if cmd_status; then exit 0; else exit 1; fi ;;
    doctor) if cmd_doctor; then exit 0; else exit 1; fi ;;
    restart-vdisp) if cmd_restart_vdisp; then exit 0; else exit 1; fi ;;
    res) if cmd_res "${1:-}"; then exit 0; else exit 1; fi ;;
  esac
}

main "$@"
