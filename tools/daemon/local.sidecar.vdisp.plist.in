<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.sidecar.vdisp</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>VDISP_WIDTH</key>
		<string>1321</string>
		<key>VDISP_HEIGHT</key>
		<string>918</string>
		<key>VDISP_KEEP_AWAKE</key>
		<string>1</string>
	</dict>
	<key>ProgramArguments</key>
	<array>
		<string>@@TOOLS@@/bin/vdisp</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>StandardOutPath</key>
	<string>@@TOOLS@@/logs/vdisp.out.log</string>
	<key>StandardErrorPath</key>
	<string>@@TOOLS@@/logs/vdisp.err.log</string>
</dict>
</plist>
