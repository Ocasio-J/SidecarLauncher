#!/usr/bin/env bash
set -u

dir="${STUB_DIR:?STUB_DIR is not set}"
counter="$dir/count.dispid"
n=0
if [ -f "$counter" ]; then n="$(cat "$counter")"; fi
n=$((n + 1))
printf '%s\n' "$n" >"$counter"
printf 'dispid %s\n' "$n" >>"$dir/calls.log"

sidecar=0
if [ "${STUB_SIDECAR_ALWAYS:-0}" = "1" ]; then
  sidecar=1
elif [ -f "$dir/display_gone" ]; then
  sidecar=0
elif [ -f "$dir/woken" ] && [ "${STUB_WAKE_SHOWS_DISPLAY:-0}" = "1" ]; then
  sidecar=1
elif [ -f "$dir/display_present" ]; then
  sidecar=1
elif [ -n "${STUB_SIDECAR_FOR_CALLS:-}" ] && [ "$n" -le "$STUB_SIDECAR_FOR_CALLS" ]; then
  sidecar=1
fi

printf 'id=%s vendor=0x%s model=0x%s serial=0 builtin=false main=%s active=true mirror_of=0 asleep=false %s\n' \
  "${STUB_VDISP_ID:-17}" "${STUB_VDISP_VENDOR:-5644}" "${STUB_VDISP_MODEL:-1}" "${STUB_VDISP_MAIN:-true}" \
  "${STUB_VDISP_RES:-1321x918}"

if [ "${STUB_BUILTIN:-0}" = "1" ]; then
  printf 'id=%s vendor=0x10ac model=0x9d1e serial=0 builtin=true main=false active=true mirror_of=0 asleep=false %s\n' \
    "${STUB_BUILTIN_ID:-1}" "${STUB_BUILTIN_RES:-2880x1800}"
fi

if [ "$sidecar" -eq 1 ]; then
  printf 'id=%s vendor=0x6161706c model=0x69506164 serial=0 builtin=false main=%s active=%s mirror_of=%s asleep=%s %s\n' \
    "${STUB_SIDECAR_ID:-22}" "${STUB_SIDECAR_MAIN:-false}" "${STUB_SIDECAR_ACTIVE:-false}" \
    "${STUB_SIDECAR_MIRROR_OF:-17}" "${STUB_SIDECAR_ASLEEP:-false}" "${STUB_SIDECAR_RES:-1321x918}"
fi

exit 0
