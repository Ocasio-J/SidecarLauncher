#!/usr/bin/env bash
set -u

dir="${STUB_DIR:?STUB_DIR is not set}"
printf 'dispmode %s\n' "$*" >>"$dir/calls.log"

if [ -n "${STUB_DISPMODE_OUT:-}" ]; then
  printf '%s\n' "$STUB_DISPMODE_OUT"
  exit "${STUB_DISPMODE_RC:-0}"
fi

printf 'display %s vendor=0x6161706c\n' "${STUB_SIDECAR_ID:-22}"
printf '  NOW: %s px=%s %sHz\n' "${STUB_SIDECAR_RES:-1321x918}" "${STUB_SIDECAR_RES:-1321x918}" 60
printf '  %s/%s 60Hz  <-- HiDPI\n' "${STUB_SIDECAR_RES:-1321x918}" "${STUB_SIDECAR_RES:-1321x918}"
exit "${STUB_DISPMODE_RC:-0}"
